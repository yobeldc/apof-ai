# ============================================================================
# Apof.ai — real local Ollama config.
# APPLY AFTER installing Ollama and pulling the models:
#   ollama pull bge-m3
#   ollama pull qwen3:8b
# Then copy these lines into `.env.local` (overrides `.env`) and run:
#   npm run rag:index -- --force   # re-embed with bge-m3
#   npm run dev
# To go back to zero-setup mock mode, delete `.env.local` (or set providers=mock).
# ============================================================================
RAG_ENABLED=true

RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BASE_URL=http://localhost:11434

RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen3:8b
RAG_LLM_BASE_URL=http://localhost:11434

RAG_VECTOR_PROVIDER=sqlite
RAG_RERANKER_PROVIDER=none
