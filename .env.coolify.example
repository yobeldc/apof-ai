# ============================================================================
# Apof.ai — Coolify environment variables.
#
# Paste these into the Apof.ai Application's "Environment Variables" tab in
# Coolify. Service hostnames (postgres, qdrant, ollama) assume Coolify's
# internal Docker network, where resources are reachable by their service
# name — see docs/DEPLOY_COOLIFY.md for exactly how to obtain each value.
# No secrets are filled in here — replace every placeholder before deploying.
# ============================================================================

NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="Apof.ai"
NEXT_PUBLIC_DEMO_MODE="false"

# --- Database ----------------------------------------------------------
# Coolify's managed PostgreSQL resource exposes a connection string you can
# copy directly — or, if the DB is in the same Coolify project, reference it
# by service name as shown below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/apofai"

# --- Local-first data storage --------------------------------------------
# Mount a Coolify persistent volume at this path (Application → Storages).
STORAGE_DIR="/app/data"

# --- Apof.ai RAG layer ----------------------------------------------------
RAG_ENABLED="true"

RAG_EMBEDDING_PROVIDER="ollama"
RAG_EMBEDDING_MODEL="bge-m3"
RAG_EMBEDDING_DIMENSION="1024"
RAG_EMBEDDING_BASE_URL="http://ollama:11434"

RAG_VECTOR_PROVIDER="qdrant"
QDRANT_URL="http://qdrant:6333"
QDRANT_COLLECTION="apofai_chunks"
QDRANT_API_KEY=""

RAG_LLM_PROVIDER="ollama"
RAG_LLM_MODEL="qwen3:8b"
RAG_LLM_BASE_URL="http://ollama:11434"
RAG_LLM_NUM_CTX="4096"
RAG_LLM_NUM_PREDICT="700"
RAG_LLM_TEMPERATURE="0.2"

# --- Ingestion (keep polite defaults in production too) ---------------------
INGESTION_ALLOWED_HOST="putusan3.mahkamahagung.go.id"
INGESTION_RESPECT_ROBOTS="true"
