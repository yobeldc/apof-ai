# ============================================================================
# Putusan Pro — Environment Configuration
# Copy this file to `.env` and adjust as needed. Sensible defaults are provided
# so the app runs locally with demo data out of the box.
# ============================================================================

# --- Database (local-first) -------------------------------------------------
# SQLite is the default for a zero-config local MVP. To use PostgreSQL instead,
# set this to a postgres URL and change `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Apof.ai"
# Demo mode seeds & serves fake sample cases so the UI is usable before any
# real ingestion. Set to "false" once you have ingested real data.
NEXT_PUBLIC_DEMO_MODE="true"

# --- Search backend ---------------------------------------------------------
# "local"  = built-in SQLite-backed search (default, zero setup)
# "meili"  = Meilisearch (faster, typo-tolerant; requires a running instance)
SEARCH_PROVIDER="local"
MEILISEARCH_HOST="http://127.0.0.1:7700"
MEILISEARCH_API_KEY=""
MEILISEARCH_INDEX="case_decisions"

# --- Ingestion (polite by default) ------------------------------------------
# The single allowed source. Ingestion refuses any URL outside this host.
INGESTION_ALLOWED_HOST="putusan3.mahkamahagung.go.id"
# Identify yourself honestly. Edit the contact to a real address you control.
INGESTION_USER_AGENT="PutusanPro-PersonalResearch/0.1 (+local; contact: you@example.com)"
# Default throttle: concurrency 1, randomized 8–20s delay, exponential backoff.
INGESTION_CONCURRENCY="1"
INGESTION_DELAY_MIN_MS="8000"
INGESTION_DELAY_MAX_MS="20000"
INGESTION_MAX_RETRIES="3"
INGESTION_BACKOFF_BASE_MS="15000"
# Caps per run (override per-job in the Ingestion dashboard).
INGESTION_MAX_LISTING_PAGES="10"
INGESTION_MAX_DETAIL_PAGES="100"
# Allowed hours (24h, local time). Empty = always allowed. e.g. "1-6,22-23".
INGESTION_ALLOWED_HOURS=""
# Respect robots.txt (strongly recommended — do not disable).
INGESTION_RESPECT_ROBOTS="true"

# --- Local storage paths ----------------------------------------------------
STORAGE_DIR="./data"

# --- Apof.ai RAG layer ------------------------------------------------------
# Defaults below run a FULLY LOCAL, zero-service "mock" pipeline so the Ask
# Apof.ai panel works out of the box. Mock providers are development-only
# (deterministic, not semantically strong) and clearly labeled in the UI.
RAG_ENABLED="true"
RAG_EMBEDDING_PROVIDER="mock"          # mock | ollama | custom_http
RAG_EMBEDDING_MODEL="mock-embedding-v1"
RAG_EMBEDDING_DIMENSION="0"            # 0 = auto-detect; set e.g. 1024 for bge-m3
RAG_EMBEDDING_BASE_URL="http://localhost:11434"
RAG_EMBEDDING_HTTP_URL=""              # for custom_http embedding server
RAG_VECTOR_PROVIDER="sqlite"           # sqlite (default) | qdrant
RAG_RERANKER_PROVIDER="none"           # none | mock | custom_http
RAG_RERANKER_HTTP_URL=""
RAG_LLM_PROVIDER="mock"                # mock | ollama | custom_http
RAG_LLM_MODEL="mock-answer-v1"
RAG_LLM_BASE_URL="http://localhost:11434"
RAG_LLM_HTTP_URL=""                    # for custom_http (OpenAI-compatible) LLM
# Resource controls (Ollama only) — important on small VPS/GPU boxes. 0 = let
# Ollama use its own default. See docs/DEPLOY_COOLIFY.md Part 5 for guidance.
RAG_LLM_NUM_CTX="0"
RAG_LLM_NUM_PREDICT="0"
RAG_LLM_TEMPERATURE="0.2"
# Recommended real local setup (after `ollama pull bge-m3` and `ollama pull qwen3:8b`):
#   RAG_EMBEDDING_PROVIDER=ollama  RAG_EMBEDDING_MODEL=bge-m3
#   RAG_LLM_PROVIDER=ollama        RAG_LLM_MODEL=qwen3:8b
# Optional Qdrant vector store (not required — SQLite works without it):
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="apof_chunks"
# Optional self-hosted OCR endpoint for scanned PDFs (no paid API). Empty = OCR off.
RAG_OCR_HTTP_URL=""

# --- Optional LLM summarization layer (disabled by default) -----------------
# When disabled, the app uses a deterministic extractive summarizer instead.
LLM_SUMMARIZATION_ENABLED="false"
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-opus-4-8"
