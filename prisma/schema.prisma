datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CaseDecision {
  id              String   @id @default(cuid())
  url             String   @unique
  nomorPutusan    String?  @map("nomor_putusan")
  pengadilan      String?
  klasifikasi     String?
  tahun           Int?
  tanggalPutusan  String?  @map("tanggal_putusan")
  tanggalRegister String?  @map("tanggal_register")
  tanggalMinutasi String?  @map("tanggal_minutasi")
  tingkatProses   String?  @map("tingkat_proses")
  hakim           String?
  panitera        String?
  pihak           String?
  pemohon         String?
  termohon        String?
  terdakwa        String?
  penggugat       String?
  tergugat        String?
  amarPutusan     String?  @map("amar_putusan")
  fullText        String?  @map("full_text")
  isDemo          Boolean  @default(false) @map("is_demo")
  sourceUrl       String?  @map("source_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  notes      CaseNote[]
  savedIn    SavedCase[]
  pages      DocumentPage[]
  chunks     DocumentChunk[]
  analysis   CaseAnalysis?

  // --- Apof Graph status & metadata ---
  apofGraphStatus      String    @default("pending") @map("apof_graph_status")
  apofGraphVersion     String?   @map("apof_graph_version")
  domainTagsJson       String    @default("[]") @map("domain_tags_json")
  sensitivityFlagsJson String    @default("[]") @map("sensitivity_flags_json")
  acquisitionMode      String?   @map("acquisition_mode")
  lastReviewedAt       DateTime? @map("last_reviewed_at")

  // --- Apof Graph relations ---
  apofGraphExtraction  ApofGraphExtraction?
  decisionJudges       DecisionJudge[]
  decisionLegalIssues  DecisionLegalIssue[]
  decisionArticles     DecisionArticle[]
  citations            DecisionCitation[]  @relation("CitingCase")
  citedIn              DecisionCitation[]  @relation("CitedCase")
  sentences            DecisionSentence[]
  similarities         DecisionSimilarity[] @relation("SimilaritySource")
  similarToMe          DecisionSimilarity[] @relation("SimilarityTarget")
  humanReviews         HumanReview[]

  @@index([apofGraphStatus])
  @@index([tahun])
  @@index([klasifikasi])
  @@index([pengadilan])
  @@map("case_decisions")
}

model DiscoveredUrl {
  id            String   @id @default(cuid())
  url           String
  normalizedUrl String   @unique @map("normalized_url")
  status        String   @default("pending")
  fetchedAt     DateTime? @map("fetched_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([normalizedUrl])
  @@map("discovered_urls")
}

model IngestionJob {
  id          String   @id @default(cuid())
  label       String
  status      String   @default("pending")
  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  summaryJson String   @default("{}") @map("summary_json")

  @@index([status])
  @@map("ingestion_jobs")
}

model CaseNote {
  id             String   @id @default(cuid())
  caseDecisionId String   @map("case_decision_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)

  @@index([caseDecisionId])
  @@map("case_notes")
}

model SavedCase {
  id             String   @id @default(cuid())
  caseDecisionId String   @map("case_decision_id")
  createdAt      DateTime @default(now()) @map("created_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)

  @@unique([caseDecisionId])
  @@map("saved_cases")
}

model SearchHistory {
  id        String   @id @default(cuid())
  query     String
  filtersJson String @default("{}") @map("filters_json")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("search_history")
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("app_settings")
}

model DocumentPage {
  id             String   @id @default(cuid())
  caseDecisionId String   @map("case_decision_id")
  pageNumber     Int      @map("page_number")
  text           String
  createdAt      DateTime @default(now()) @map("created_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)

  @@unique([caseDecisionId, pageNumber])
  @@index([caseDecisionId])
  @@map("document_pages")
}

model DocumentChunk {
  id             String   @id @default(cuid())
  caseDecisionId String   @map("case_decision_id")
  pageId         String?  @map("page_id")
  text           String
  startOffset    Int      @map("start_offset")
  endOffset      Int      @map("end_offset")
  createdAt      DateTime @default(now()) @map("created_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)
  embeddings   ChunkEmbedding[]

  @@index([caseDecisionId])
  @@index([pageId])
  @@map("document_chunks")
}

model ChunkEmbedding {
  id       String @id @default(cuid())
  chunkId  String @map("chunk_id")
  model    String
  vector   Bytes
  metadata String @default("{}")

  chunk DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, model])
  @@index([chunkId])
  @@map("chunk_embeddings")
}

model CaseAnalysis {
  id             String   @id @default(cuid())
  caseDecisionId String   @unique @map("case_decision_id")
  method         String   @default("deterministic")
  breakdownJson  String   @map("breakdown_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)

  @@map("case_analyses")
}

model RagQueryLog {
  id            String   @id @default(cuid())
  question      String
  filtersJson   String   @default("{}") @map("filters_json")
  retrievedJson String   @default("[]") @map("retrieved_json")
  answer        String?
  abstained     Boolean  @default(false)
  provider      String?
  model         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("rag_query_logs")
}

// ===========================================================================
// Apof Graph layer
// ===========================================================================

model ApofGraphExtraction {
  id                    String   @id @default(cuid())
  caseDecisionId        String   @unique @map("case_decision_id")
  schemaVersion         String   @map("schema_version")
  promptVersion         String   @map("prompt_version")
  extractionMethod      String   @map("extraction_method")
  fullJson              String   @map("full_json")
  confidenceJson        String   @map("confidence_json")
  unsupportedFieldsJson String   @default("[]") @map("unsupported_fields_json")
  evidenceSpansJson     String   @default("[]") @map("evidence_spans_json")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)

  @@index([caseDecisionId])
  @@map("apof_graph_extractions")
}

model Judge {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @unique @map("name_normalized")
  title          String?
  createdAt      DateTime @default(now()) @map("created_at")

  decisions DecisionJudge[]

  @@map("judges")
}

model DecisionJudge {
  id             String   @id @default(cuid())
  caseDecisionId String   @map("case_decision_id")
  judgeId        String   @map("judge_id")
  role           String
  createdAt      DateTime @default(now()) @map("created_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)
  judge        Judge        @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([caseDecisionId, judgeId, role])
  @@index([caseDecisionId])
  @@index([judgeId])
  @@map("decision_judges")
}

model LegalIssue {
  id          String   @id @default(cuid())
  label       String   @unique
  category    String
  description String?
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")

  parent    LegalIssue?        @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  LegalIssue[]       @relation("IssueHierarchy")
  decisions DecisionLegalIssue[]

  @@index([parentId])
  @@map("legal_issues")
}

model DecisionLegalIssue {
  id                  String   @id @default(cuid())
  caseDecisionId      String   @map("case_decision_id")
  legalIssueId        String   @map("legal_issue_id")
  confidence          Float    @default(0)
  evidenceSpanIdsJson String   @default("[]") @map("evidence_span_ids_json")
  determinedBy        String   @default("llm")
  createdAt           DateTime @default(now()) @map("created_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)
  legalIssue   LegalIssue   @relation(fields: [legalIssueId], references: [id], onDelete: Cascade)

  @@unique([caseDecisionId, legalIssueId])
  @@index([caseDecisionId])
  @@index([legalIssueId])
  @@map("decision_legal_issues")
}

model Statute {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @unique @map("name_normalized")
  shortName      String?  @map("short_name")
  category       String?
  createdAt      DateTime @default(now()) @map("created_at")

  articles StatuteArticle[]

  @@map("statutes")
}

model StatuteArticle {
  id            String   @id @default(cuid())
  statuteId     String   @map("statute_id")
  articleNumber String   @map("article_number")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  statute   Statute         @relation(fields: [statuteId], references: [id], onDelete: Cascade)
  decisions DecisionArticle[]

  @@unique([statuteId, articleNumber])
  @@index([statuteId])
  @@map("statute_articles")
}

model DecisionArticle {
  id               String   @id @default(cuid())
  caseDecisionId   String   @map("case_decision_id")
  statuteArticleId String   @map("statute_article_id")
  context          String?
  confidence       Float    @default(0)
  determinedBy     String   @default("deterministic")
  createdAt        DateTime @default(now()) @map("created_at")

  caseDecision   CaseDecision   @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)
  statuteArticle StatuteArticle @relation(fields: [statuteArticleId], references: [id], onDelete: Cascade)

  @@unique([caseDecisionId, statuteArticleId])
  @@index([caseDecisionId])
  @@index([statuteArticleId])
  @@map("decision_articles")
}

model DecisionCitation {
  id                  String   @id @default(cuid())
  caseDecisionId      String   @map("case_decision_id")
  citedCaseDecisionId String   @map("cited_case_decision_id")
  citationContext     String?  @map("citation_context")
  treatment           String?
  confidence          Float    @default(0)
  createdAt           DateTime @default(now()) @map("created_at")

  caseDecision      CaseDecision @relation("CitingCase", fields: [caseDecisionId], references: [id], onDelete: Cascade)
  citedCaseDecision CaseDecision @relation("CitedCase", fields: [citedCaseDecisionId], references: [id], onDelete: Cascade)

  @@unique([caseDecisionId, citedCaseDecisionId])
  @@index([caseDecisionId])
  @@index([citedCaseDecisionId])
  @@map("decision_citations")
}

model DecisionSentence {
  id                     String   @id @default(cuid())
  caseDecisionId         String   @map("case_decision_id")
  defendantName          String?  @map("defendant_name")
  sentenceType           String   @map("sentence_type")
  durationMonths         Int?     @map("duration_months")
  fineAmount             Float?   @map("fine_amount")
  fineCurrency           String   @default("IDR") @map("fine_currency")
  restitutionAmount      Float?   @map("restitution_amount")
  restitutionCurrency    String   @default("IDR") @map("restitution_currency")
  aggravatingFactorsJson String   @default("[]") @map("aggravating_factors_json")
  mitigatingFactorsJson  String   @default("[]") @map("mitigating_factors_json")
  isProbation            Boolean  @default(false) @map("is_probation")
  confidence             Float    @default(0)
  evidenceSpansJson      String   @default("[]") @map("evidence_spans_json")
  createdAt              DateTime @default(now()) @map("created_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)

  @@index([caseDecisionId])
  @@index([sentenceType])
  @@map("decision_sentences")
}

model DecisionSimilarity {
  id                    String   @id @default(cuid())
  caseDecisionId        String   @map("case_decision_id")
  similarCaseDecisionId String   @map("similar_case_decision_id")
  score                 Float
  explanationJson       String   @map("explanation_json")
  sharedIssueIdsJson    String   @default("[]") @map("shared_issue_ids_json")
  sharedArticleIdsJson  String   @default("[]") @map("shared_article_ids_json")
  createdAt             DateTime @default(now()) @map("created_at")

  caseDecision        CaseDecision @relation("SimilaritySource", fields: [caseDecisionId], references: [id], onDelete: Cascade)
  similarCaseDecision CaseDecision @relation("SimilarityTarget", fields: [similarCaseDecisionId], references: [id], onDelete: Cascade)

  @@unique([caseDecisionId, similarCaseDecisionId])
  @@index([caseDecisionId])
  @@index([similarCaseDecisionId])
  @@map("decision_similarities")
}

model HumanReview {
  id              String    @id @default(cuid())
  caseDecisionId  String    @map("case_decision_id")
  reviewer        String?
  status          String    @default("pending")
  priority        String    @default("normal")
  reviewType      String    @map("review_type")
  findingsJson    String    @default("[]") @map("findings_json")
  correctionsJson String    @default("[]") @map("corrections_json")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  completedAt     DateTime? @map("completed_at")

  caseDecision CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Cascade)

  @@index([caseDecisionId])
  @@index([status])
  @@index([priority])
  @@map("human_reviews")
}