# ============================================================================
# Apof.ai — PRODUCTION environment reference (generic, any host).
#
# This is not tied to any specific PaaS — see .env.coolify.example for the
# Coolify-specific service-name variant. Copy the relevant values into your
# host's env var UI (Coolify's "Environment Variables" tab). Never commit a
# real filled-in copy of this file.
# ============================================================================

NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="Apof.ai"
NEXT_PUBLIC_DEMO_MODE="false"

# --- Database — PostgreSQL is the recommended production database ----------
# Provided by your host (Coolify's managed Postgres, a managed DB, etc).
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/apofai"

# --- Search backend -----------------------------------------------------
SEARCH_PROVIDER="local"

# --- Ingestion (polite by default — keep these values in production too) ---
INGESTION_ALLOWED_HOST="putusan3.mahkamahagung.go.id"
INGESTION_USER_AGENT="ApofAi-PersonalResearch/0.1 (+https://your-domain.example; contact: you@example.com)"
INGESTION_CONCURRENCY="1"
INGESTION_DELAY_MIN_MS="8000"
INGESTION_DELAY_MAX_MS="20000"
INGESTION_MAX_RETRIES="3"
INGESTION_BACKOFF_BASE_MS="15000"
INGESTION_MAX_LISTING_PAGES="10"
INGESTION_MAX_DETAIL_PAGES="100"
INGESTION_ALLOWED_HOURS=""
INGESTION_RESPECT_ROBOTS="true"

# --- Local-first data storage ------------------------------------------
# MUST be a persistent volume mount in production, not container-local disk —
# otherwise offline-imported HTML/PDFs and the fetch cache are lost on redeploy.
STORAGE_DIR="/app/data"

# --- Apof.ai RAG layer ----------------------------------------------------
RAG_ENABLED="true"

RAG_EMBEDDING_PROVIDER="ollama"
RAG_EMBEDDING_MODEL="bge-m3"
RAG_EMBEDDING_DIMENSION="1024"
# Your PRIVATE Ollama endpoint — never a public URL with no auth. See
# docs/DEPLOY_COOLIFY.md Part 5 for the three supported strategies.
RAG_EMBEDDING_BASE_URL="https://your-private-ollama-endpoint.internal"

RAG_VECTOR_PROVIDER="qdrant"
QDRANT_URL="http://qdrant:6333"
QDRANT_COLLECTION="apofai_chunks"
QDRANT_API_KEY=""

RAG_RERANKER_PROVIDER="none"

RAG_LLM_PROVIDER="ollama"
RAG_LLM_MODEL="qwen3:8b"
RAG_LLM_BASE_URL="https://your-private-ollama-endpoint.internal"
# Resource controls — lower these on small VPS/GPU or CPU-only boxes.
# qwen3:8b may be too heavy for <16GB RAM or <8GB VRAM; see the docs.
RAG_LLM_NUM_CTX="4096"
RAG_LLM_NUM_PREDICT="700"
RAG_LLM_TEMPERATURE="0.2"

# --- Optional LLM summarization layer (disabled by default) -----------------
LLM_SUMMARIZATION_ENABLED="false"
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-opus-4-8"
